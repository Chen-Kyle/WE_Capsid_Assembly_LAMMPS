# HBV Decamer CG Oligomer — Basis State Generator
# Split out of scripts/lammps_oligomer.in for use as a WESTPA basis state.
#
# Run ONCE per starting structure/Enative to produce a minimized, relaxed
# restart file. WESTPA seeds iteration 1 of every walker from this restart
# instead of re-minimizing every WE segment.
#
# Normally invoked via ../make_basis_state.sh, which runs generate_lammps_data.py
# against a specific PDB first to populate topology_dir, then calls this file:
#   python generate_lammps_data.py \
#       --pdb        decamer_sep.pdb   \
#       --conndir    connect_files     \
#       --contactdir .                 \
#       --Enative    1.0               \
#       --output_dir topology_dir
#
# generate_lammps_data.py produces, ONCE, in topology_dir (common_files/):
#   decamer.lammps                      atom/bond topology (one type per chain+resnum)
#   gaussian_native_{A,B,C,D}.table     tabulated Gaussian potentials
#   harmonic_bond_coeffs.lammps         bond_coeff lines for ENM bonds
#   native_contact_pair_coeffs.lammps   pair_coeff lines for native contacts
#
# Every downstream WE segment (dynamics.in) reads these same shared files —
# they are never regenerated per-segment.
#
# Run directly (rare — prefer make_basis_state.sh):
#   lmp -in make_basis_state.in -var topology_dir {dir} -var bstate_dir {dir} -var myseed 42
#
# NOTE: Enative must match the value baked into topology_dir's Gaussian table
# files at generation time (see lammps_oligomer.in).

# ---------------------------------------------------------------------------
# INPUT PARAMETERS  (override via -var on the command line)
# ---------------------------------------------------------------------------
variable    Erepulsion   index 1.0      # dimensionless scale on cosine repulsion
variable    myseed       index 42       # Langevin random seed
variable    topology_dir index ""       # dir with decamer.lammps + coeff/table files
variable    bstate_dir   index ""       # dir to write the basis-state restart into

variable    A_soft  equal ${Erepulsion}*10   # kcal/mol

# ---------------------------------------------------------------------------
# SIMULATION BOX AND TOPOLOGY
# ---------------------------------------------------------------------------
units       real
atom_style  bond
boundary    p p p   # Periodic Boundary Conditions

read_data   ${topology_dir}/decamer.lammps

# ---------------------------------------------------------------------------
# PAIR STYLE: hybrid/overlay  (see lammps_oligomer.in for details)
# ---------------------------------------------------------------------------
pair_style  hybrid/overlay soft 4 table linear 20000
pair_coeff  * *  soft ${A_soft} 6
include     ${topology_dir}/native_contact_pair_coeffs.lammps

special_bonds lj 1 1 1

# ---------------------------------------------------------------------------
# BOND STYLE: harmonic ENM bonds only
# ---------------------------------------------------------------------------
bond_style  harmonic

include     ${topology_dir}/harmonic_bond_coeffs.lammps

# ---------------------------------------------------------------------------
# INTEGRATOR: Langevin dynamics
# ---------------------------------------------------------------------------
timestep    10.0            # fs

fix     NVE  all nve
fix     LANG all langevin 300.0 300.0 500.0 ${myseed}

# ---------------------------------------------------------------------------
# ENERGY MINIMIZATION  (matches simulation.minimizeEnergy(tolerance=0.1))
#
# This is the ONLY place minimization happens in the WE workflow — every
# downstream segment (dynamics.in) reads this restart and never re-minimizes.
# ---------------------------------------------------------------------------
minimize    1.0e-4 1.0e-6 10000 100000

reset_timestep 0

write_data    ${bstate_dir}/bstate.lammps nocoeff
write_restart ${bstate_dir}/bstate.restart

print "------------------------------------------------------------"
print "Basis state restart written to: ${bstate_dir}/bstate.restart"
print "------------------------------------------------------------"
